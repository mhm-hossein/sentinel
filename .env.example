# Sentinel Platform configuration.
# Get API_ID and API_HASH from https://my.telegram.org (API development tools).
# Keep this file private — it is git-ignored.
#
# Production (control plane):  python start.py
# Development (single user):   python -m sentinel.run_local
# See README.md → "Environment variables" for the full reference.

# ============================================================================
# MULTI-USER PLATFORM (control plane)
# ----------------------------------------------------------------------------
# One shared Telegram *application* (API_ID/API_HASH) authorizes every user's
# login, so tenants supply only phone + code + 2FA via the control bot.
SENTINEL_API_ID=123456
SENTINEL_API_HASH=your_api_hash_here
# Control bot (a Bot API bot from @BotFather) that drives self-serve onboarding.
CONTROL_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to run admin commands on the bot.
SENTINEL_ADMIN_IDS=
# The platform OWNER (full RBAC access; can manage admins). One Telegram id.
SENTINEL_OWNER_ID=
# Subscription checker cadence (seconds) + whether expiry stops a user's workers.
SENTINEL_SUBCHECK_SECONDS=300
SENTINEL_STOP_ON_EXPIRE=0
# System alerts to the owner (Phase 5). Health-loop cadence + thresholds.
SENTINEL_ALERT_SECONDS=120
SENTINEL_ALERT_DISK_FREE_PCT=10
SENTINEL_ALERT_RAM_PCT=90
SENTINEL_ALERT_GEMINI_FAILS=20
# Platform storage. Per-user data lives under <SENTINEL_DATA_ROOT>/users/<id>/.
SENTINEL_DATA_ROOT=data
# Central control-plane DB (defaults to <SENTINEL_DATA_ROOT>/central.db).
SENTINEL_CENTRAL_DB=
# Default plan/tier assigned to newly onboarded users (bronze | silver | gold).
# Tiers differ by max instances: bronze=1, silver=2, gold=unlimited.
SENTINEL_DEFAULT_PLAN=bronze
# Supervisor: max concurrently running worker processes (0 = unlimited).
SENTINEL_MAX_WORKERS=0
# Control-panel support contact shown in the 🆘 Support screen.
SENTINEL_SUPPORT_CONTACT=@your_support
# Optional URL to full Terms of Service (shown on the ToS accept screen).
SENTINEL_TOS_URL=
# Worker heartbeat cadence in seconds (drives the status panel freshness).
SENTINEL_HEARTBEAT_SECONDS=30
# ============================================================================

# --- Required (legacy single-user / run_local dev mode) ---
BANNER_API_ID=123456
BANNER_API_HASH=your_api_hash_here

# --- Phone number in international format, e.g. +15551234567 ---
BANNER_PHONE=+10000000000

# --- Optional ---
BANNER_SESSION=banner
# Database path. SENTINEL_DB_PATH is preferred; BANNER_DB_PATH still works.
# A legacy banner.db / banners.db is auto-migrated to sentinel.db on first run.
SENTINEL_DB_PATH=sentinel.db
BANNER_PREFIX=.
BANNER_LOG_LEVEL=INFO

# --- Sentinel modules ---
# Tracking feature defaults (runtime .on/.off overrides persist in the DB)
AUTOSAVE_ENABLED=0
ANTIDELETE_ENABLED=0
ANTIEDIT_ENABLED=0
LOGGER_ENABLED=0
# Backup output directory and VPS ping target
BACKUP_PATH=backups
PING_HOST=8.8.8.8

# --- AI Assistant (Google Gemini) ---
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
DEFAULT_AI_MODEL=gemini-2.5-flash
# Optional: comma-separated extra models to add to the selectable list
# AI_MODELS=gemini-2.5-flash-lite
# Fallback chain tried (in order) when the active model fails transiently
AI_FALLBACK_MODELS=gemini-2.0-flash,gemini-2.0-flash-lite
MAX_FILE_SIZE_MB=20
AI_RATE_LIMIT_PER_MINUTE=10
AI_REQUEST_TIMEOUT=60

# --- Archive Watch ---
ARCHIVE_INITIAL_MESSAGES=1000
ARCHIVE_SYNC_INTERVAL_MINUTES=30
# Directory for chat/search export files
EXPORTS_PATH=data/exports

# --- Ghost Tracker ---
# Minutes between automatic profile-change scans (minimum 1).
GHOST_CHECK_INTERVAL_MINUTES=30

# --- Username Hunter ---
# Seconds between username availability checks (minimum 15).
HUNTER_CHECK_INTERVAL_SECONDS=60
# Reserve entity a freed username is claimed onto: channel | group
HUNTER_CLAIM_TARGET=channel
